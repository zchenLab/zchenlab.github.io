---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in site.html_pages %}
{%- unless p.sitemap == false or p.noindex %}
  <url>
    <loc>{{ p.url | replace: "index.html", "" | replace: ".html", "" | absolute_url }}</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <priority>{% if p.url == "/" %}1.0{% else %}0.8{% endif %}</priority>
  </url>
{%- endunless %}
{%- endfor %}
</urlset>
